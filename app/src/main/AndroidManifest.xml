<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Apps signed with the same key (Reader's Launcher) read and write tasks without a prompt. -->
    <permission
        android:name="com.freedomfighter.readerstasks.permission.ACCESS"
        android:protectionLevel="signature" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ReadersTasks">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.LineWidget" android:exported="true" android:label="@string/widget_line_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_line_info" />
        </receiver>
        <receiver android:name=".widget.ListWidget" android:exported="true" android:label="@string/widget_list_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_list_info" />
        </receiver>
        <service android:name=".widget.ListService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <provider
            android:name=".provider.TasksProvider"
            android:authorities="com.freedomfighter.readerstasks"
            android:exported="true"
            android:permission="com.freedomfighter.readerstasks.permission.ACCESS" />
        <!-- the credentials file handed to the share sheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.freedomfighter.readerstasks.credentials"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/credentials_paths" />
        </provider>
    </application>
</manifest>
